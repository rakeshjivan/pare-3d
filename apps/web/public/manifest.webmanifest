{
  "id": "/",
  "name": "Pare 3D",
  "short_name": "Pare 3D",
  "description": "Easy 3D design for 3D printing",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/vnd.layerling.project+zip": [".lyl"] }
    }
  ],
  "orientation": "any",
  "background_color": "#fafafa",
  "theme_color": "#ffffff",
  "categories": ["graphics", "productivity", "utilities"],
  "icons": [
    {
      "src": "assets/pare3d/pare3d-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/pare3d/pare3d-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/pare3d/pare3d-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/pare3d/pare3d-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
