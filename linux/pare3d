#!/usr/bin/env bash
# Pare 3D for Linux (build 32): starts the bundled local server, opens the app in its own browser
# window, and stops the server when that window closes. Designs are kept in ~/.pare3d/designs.
#   ./pare3d            start Pare 3D
#   ./pare3d --install  add Pare 3D to the applications menu (and remove the old entry first)
#   ./pare3d --uninstall
set -u
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
DATA="$HOME/.pare3d"
PROFILE="$DATA/browser-profile"
LOG="$DATA/launcher.log"
mkdir -p "$PROFILE"

DESKTOP="$HOME/.local/share/applications/pare3d.desktop"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
if [ "${1:-}" = "--install" ]; then
  mkdir -p "$(dirname "$DESKTOP")" "$ICON_DIR"
  cp "$HERE/pare3d.png" "$ICON_DIR/pare3d.png" 2>/dev/null || true
  cat > "$DESKTOP" <<DESK
[Desktop Entry]
Type=Application
Name=Pare 3D
Comment=3D design for 3D printing
Exec="$HERE/pare3d"
Icon=pare3d
Terminal=false
Categories=Graphics;3DGraphics;Engineering;
StartupWMClass=Pare 3D
DESK
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$(dirname "$DESKTOP")" >/dev/null 2>&1
  echo "Pare 3D is in your applications menu now."
  exit 0
fi
if [ "${1:-}" = "--uninstall" ]; then
  rm -f "$DESKTOP" "$ICON_DIR/pare3d.png"
  echo "Removed Pare 3D from the applications menu. Your designs stay in $DATA/designs."
  exit 0
fi

exec >>"$LOG" 2>&1
echo "--- $(date) starting from $HERE"
case "$(uname -m)" in
  aarch64|arm64) BUN="$HERE/bun-arm64" ;;
  *) BUN="$HERE/bun-x64" ;;
esac
[ -x "$BUN" ] || chmod +x "$BUN" 2>/dev/null

say() { # a message the person sees even without a terminal
  echo "$1"
  if command -v notify-send >/dev/null 2>&1; then notify-send "Pare 3D" "$1"
  elif command -v zenity >/dev/null 2>&1; then zenity --info --title="Pare 3D" --text="$1" &
  fi
}
fetch() { if command -v curl >/dev/null 2>&1; then curl -s --max-time 1 "$@"; else wget -q -T 1 -O - "$@"; fi; }
is_ours() { [ "$(fetch "http://localhost:$1/__pare3d")" = "pare3d" ]; }
OWN_RUNTIME=6
OWN_BUILD="$(tr -dc '0-9' < "$HERE/app/pare-build.txt" 2>/dev/null)"; OWN_BUILD="${OWN_BUILD:-0}"
is_current() {
  local state runtime serving
  state="$(fetch "http://localhost:$1/__pare3d/update")"
  runtime="$(printf '%s' "$state" | sed -n 's/.*"runtime":\([0-9]*\).*/\1/p')"
  serving="$(printf '%s' "$state" | sed -n 's/.*"serving":\([0-9]*\).*/\1/p')"
  [ "${runtime:-0}" -ge "$OWN_RUNTIME" ] && [ "${serving:-0}" -ge "$OWN_BUILD" ]
}
port_busy() { fetch -o /dev/null "http://localhost:$1/" >/dev/null 2>&1 || (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
stop_server() {
  if command -v curl >/dev/null 2>&1; then curl -s -X POST --max-time 1 "http://localhost:$1/__pare3d/quit" >/dev/null 2>&1; fi
  for _ in $(seq 1 30); do port_busy "$1" || return 0; sleep 0.1; done
}

PORT=""
SERVER=""
for CANDIDATE in 47177 47178 47179 47180 47181; do
  if is_ours "$CANDIDATE"; then
    if is_current "$CANDIDATE"; then PORT=$CANDIDATE; echo "reusing Pare 3D server on $PORT"; break; fi
    echo "replacing an older Pare 3D server on $CANDIDATE"; stop_server "$CANDIDATE"
  fi
  if ! port_busy "$CANDIDATE"; then
    PORT=$CANDIDATE "$BUN" "$HERE/serve.mjs" &
    SERVER=$!
    for _ in $(seq 1 100); do is_ours "$CANDIDATE" && break; sleep 0.1; done
    if is_ours "$CANDIDATE"; then PORT=$CANDIDATE; echo "started server on $PORT"; break; fi
    echo "server did not start on $CANDIDATE"; kill "$SERVER" 2>/dev/null; SERVER=""
  else
    echo "port $CANDIDATE is used by something else"
  fi
done
if [ -z "$PORT" ]; then
  say "Pare 3D could not start: its local server did not start. Details are in $LOG"
  exit 1
fi
URL="http://localhost:$PORT/"
cleanup() { [ -n "$SERVER" ] && kill "$SERVER" 2>/dev/null; }
trap cleanup EXIT

# A Chromium browser as an app window with its own profile: no tabs or address bar, designs apart
# from normal browsing. Waiting on it means the server stops when the window closes.
for BROWSER in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge microsoft-edge-stable brave-browser vivaldi; do
  if command -v "$BROWSER" >/dev/null 2>&1; then
    echo "using $BROWSER at $URL"
    "$BROWSER" --app="$URL" --user-data-dir="$PROFILE" --class="Pare 3D" \
      --no-first-run --no-default-browser-check --disable-session-crashed-bubble --window-size=1440,900
    exit 0
  fi
done
# Snap and Flatpak Chromium.
if command -v flatpak >/dev/null 2>&1; then
  for APP in com.google.Chrome org.chromium.Chromium com.microsoft.Edge com.brave.Browser; do
    if flatpak info "$APP" >/dev/null 2>&1; then
      echo "using flatpak $APP at $URL"
      flatpak run "$APP" --app="$URL" --user-data-dir="$PROFILE" --no-first-run --no-default-browser-check
      exit 0
    fi
  done
fi

echo "no Chromium browser, using the default at $URL"
say "Opened in your browser. Chrome or Chromium gives Pare 3D its own window."
xdg-open "$URL" >/dev/null 2>&1 || true
[ -n "$SERVER" ] && wait "$SERVER"
