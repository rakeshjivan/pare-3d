#!/bin/bash
# Pare 3D launcher: starts the bundled local server, opens the app in its own
# browser window, and stops the server when that browser instance quits.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
SUPPORT="$HOME/Library/Application Support/Pare 3D"
PROFILE="$SUPPORT/browser-profile"
mkdir -p "$PROFILE"
LOG="$SUPPORT/launcher.log"
exec >>"$LOG" 2>&1
echo "--- $(date) starting from $RES"

# The runtime for this Mac's chip: Apple silicon or Intel.
if [ "$(/usr/bin/uname -m)" = "arm64" ]; then BUN="$RES/bun-arm64"; else BUN="$RES/bun-x64"; fi
[ -x "$BUN" ] || BUN="$RES/bun"

is_ours() { [ "$(/usr/bin/curl -s --max-time 1 "http://localhost:$1/__pare3d")" = "pare3d" ]; }
# Build 29: a server left running by an older app is replaced, not reused (runtime and served build).
OWN_RUNTIME=5
OWN_BUILD="$(tr -dc '0-9' < "$RES/app/pare-build.txt" 2>/dev/null)"; OWN_BUILD="${OWN_BUILD:-0}"
is_current() {
  local state runtime serving
  state="$(/usr/bin/curl -s --max-time 1 "http://localhost:$1/__pare3d/update")"
  runtime="$(printf '%s' "$state" | /usr/bin/sed -n 's/.*"runtime":\([0-9]*\).*/\1/p')"
  serving="$(printf '%s' "$state" | /usr/bin/sed -n 's/.*"serving":\([0-9]*\).*/\1/p')"
  [ "${runtime:-0}" -ge "$OWN_RUNTIME" ] && [ "${serving:-0}" -ge "$OWN_BUILD" ]
}
stop_server() {
  /usr/bin/curl -s -X POST --max-time 1 "http://localhost:$1/__pare3d/quit" >/dev/null 2>&1
  for _ in $(seq 1 20); do port_busy "$1" || return 0; sleep 0.1; done
  for PID in $(/usr/sbin/lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null); do kill "$PID" 2>/dev/null; done
  for _ in $(seq 1 30); do port_busy "$1" || return 0; sleep 0.1; done
}
port_busy() { /usr/bin/curl -s -o /dev/null --max-time 1 "http://localhost:$1/"; }

# Our own port, well away from common ones. If something else holds it, try the next few.
PORT=""
SERVER=""
for CANDIDATE in 47177 47178 47179 47180 47181; do
  if is_ours "$CANDIDATE"; then
    if is_current "$CANDIDATE"; then PORT=$CANDIDATE; echo "reusing Pare 3D server on $PORT"; break; fi
    echo "replacing an older Pare 3D server on $CANDIDATE"; stop_server "$CANDIDATE"
  fi
  if ! port_busy "$CANDIDATE"; then
    PORT=$CANDIDATE "$BUN" "$RES/serve.mjs" &
    SERVER=$!
    for _ in $(seq 1 100); do is_ours "$CANDIDATE" && break; sleep 0.1; done
    if is_ours "$CANDIDATE"; then PORT=$CANDIDATE; echo "started server on $PORT"; break; fi
    echo "server did not start on $CANDIDATE"; kill "$SERVER" 2>/dev/null; SERVER=""
  else
    echo "port $CANDIDATE is used by something else"
  fi
done
if [ -z "$PORT" ]; then
  /usr/bin/osascript -e 'display alert "Pare 3D could not start" message "Its local server did not start. See ~/Library/Application Support/Pare 3D/launcher.log"'
  exit 1
fi
URL="http://localhost:$PORT/"
cleanup() { [ -n "$SERVER" ] && kill "$SERVER" 2>/dev/null; }
trap cleanup EXIT

# A Chromium browser opened as an app window with its own profile: no tabs or
# address bar, designs kept apart from normal browsing, automatic backup works.
for BROWSER in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium" "Vivaldi"; do
  for ROOT in "/Applications" "$HOME/Applications"; do
    APPDIR="$ROOT/$BROWSER.app"
    if [ -d "$APPDIR" ]; then
      EXE="$(/usr/bin/defaults read "$APPDIR/Contents/Info" CFBundleExecutable 2>/dev/null || echo "$BROWSER")"
      echo "using $BROWSER at $URL"
      # Started directly, not through "open": that also sends the browser a "reopen" event,
      # which made it add an empty New Tab window beside Pare 3D. Waiting on the process
      # means the server stops when this browser instance quits.
      "$APPDIR/Contents/MacOS/$EXE" \
        --app="$URL" --user-data-dir="$PROFILE" \
        --no-first-run --no-default-browser-check --disable-session-crashed-bubble \
        --window-size=1440,900
      exit 0
    fi
  done
done

echo "no Chromium browser, using default at $URL"
/usr/bin/osascript -e 'display notification "Opened in your browser. Chrome or Edge gives Pare 3D its own window and automatic backup." with title "Pare 3D"' || true
/usr/bin/open "$URL"
[ -n "$SERVER" ] && wait "$SERVER"
