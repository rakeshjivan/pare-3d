<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pare 3D for Windows: a native window (WebView2, the Edge engine built into Windows)
       around the app. Built on GitHub by .github/workflows/pare3d-release.yml. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Pare3D</AssemblyName>
    <RootNamespace>Pare3D</RootNamespace>
    <ApplicationIcon>Pare3D.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Product>Pare 3D</Product>
    <Description>Pare 3D - based on layerling (AGPL-3.0-only)</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>
</Project>
